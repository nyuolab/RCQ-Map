# Copy to .env (never commit .env). All values below are placeholders.

# Postgres connection string (required outside local demo mode)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Shared access code that clinicians enter to start annotating (required in production)
EVAL_ACCESS_CODE=choose-a-long-random-code

# HTTP Basic Auth for /admin and /api/admin/* (required in production)
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-random-password

# Your query CSV (columns: id, specialty, question). Keep it OUTSIDE this repository.
ANNOTATION_INPUT=/secure/path/to/queries.csv

# Optional: host the query file in a private Vercel Blob store instead of bundling it at build time
# ANNOTATION_BLOB_URL=https://<store>.private.blob.vercel-storage.com/queries.csv
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Optional branding
NEXT_PUBLIC_STUDY_MARK=RCQ
NEXT_PUBLIC_STUDY_TITLE=RCQ-Map annotation
